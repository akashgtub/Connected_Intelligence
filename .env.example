# FalkorDB Connection Settings
# Option A: Local FalkorDB Docker container (Default)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=

# Option B: FalkorDB Cloud (Alternative)
# If using FalkorDB Cloud, provide the full connection URL or host/port/credentials:
# FALKORDB_URL=falkor://username:password@your-cloud-instance.falkordb.cloud:port
FALKORDB_GRAPH=company_brain

# Application Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional AI Key (If omitted, the deterministic graph reasoning engine will be used)
OPENAI_API_KEY=
GEMINI_API_KEY=
