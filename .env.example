# =========================================================
# Connected Intelligence — Root Environment Example
# =========================================================

# Database Connection (FalkorDB)
# For Render deployment, configure FALKORDB_URL in the Render backend service:
# FALKORDB_URL=falkor://username:password@your-instance.falkordb.cloud:port
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=company_brain

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Static Site
VITE_API_BASE_URL=http://localhost:8000

# Optional AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
