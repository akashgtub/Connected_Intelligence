# =========================================================
# Connected Intelligence — Backend Environment Variables
# =========================================================

# Database Connection (FalkorDB)
# ---------------------------------------------------------
# Option A: Remote FalkorDB Cloud (Production on Render)
# Secure TLS URI (Recommended for FalkorDB Cloud):
# FALKORDB_URL=falkors://falkordb:your_password@your-endpoint.falkordb.cloud:port
# (Also supports rediss://, falkor://, or redis://)
FALKORDB_URL=

# Option B: Local Docker Container or Discrete Credentials
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=
FALKORDB_SSL=false

# Graph Name in FalkorDB (Always company_brain)
FALKORDB_GRAPH=company_brain

# CORS Configuration
# In production on Render, set this to your deployed Frontend Static Site URL:
# Example: https://connected-intelligence-ui.onrender.com
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port (Render injects PORT automatically)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional AI API Keys (If omitted, deterministic graph reasoning engine is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
