# =========================================================
# Connected Intelligence — Frontend Environment Variables
# =========================================================

# URL of the deployed FastAPI backend on Render.
# In production on Render Static Site, set this to your backend service URL:
# Example: https://connected-intelligence-api.onrender.com
# For local development with backend running on port 8000, you can leave this blank or set to:
VITE_API_BASE_URL=http://localhost:8000
